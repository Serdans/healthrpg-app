{
	"name": "healthrpg-app",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev",
		"storybook": "storybook dev --port 6006",
		"build-storybook": "storybook build",
		"test-storybook": "vitest --config .storybook/vitest.config.ts --run",
		"generate-routes": "tsr generate",
		"api:generate": "openapi-typescript ../healthrpg/openapi.json -o src/api/generated.ts",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"preview": "vite preview",
		"lint": "eslint",
		"doctor": "react-doctor --no-telemetry",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write . && eslint --fix",
		"check": "prettier --check .",
		"validate": "pnpm check && pnpm lint",
		"verify": "pnpm validate && pnpm typecheck && pnpm doctor && pnpm test && pnpm test-storybook && pnpm build",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@pixi/react": "^8.0.5",
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.12",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "1.170.31",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-start": "1.168.48",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"ky": "^2.0.2",
		"lucide-react": "^0.577.0",
		"pixi.js": "^8.20.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-reconciler": "0.31.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"ts-pattern": "5.9.0",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/react-vite": "^10.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/eslint-config": "0.4.0",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^9.20.0",
		"nitro": "3.0.260610-beta",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.1",
		"react-doctor": "0.9.12",
		"storybook": "^10.5.10",
		"tsx": "^4.23.12",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^4.1.11"
	}
}
